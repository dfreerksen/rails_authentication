# frozen_string_literal: true

module ConfirmableConcern
  extend ActiveSupport::Concern

  CONFIRMATION_TOKEN_EXPIRES_IN = 24.hours

  included do
<% if reconfirmable? -%>
    before_update :postpone_email_change, if: :postponing_email_change?
    after_update_commit :deliver_reconfirmation_instructions, if: -> { saved_change_to_<%= unconfirmed_email_attribute %>? && <%= unconfirmed_email_attribute %>.present? }

<% end -%>
    scope :confirmed, -> { where.not(confirmed_at: nil) }
    scope :unconfirmed, -> { where(confirmed_at: nil) }
  end

  class_methods do
    def find_by_valid_confirmation_token(token)
      return if token.blank?

      user = find_by(confirmation_token: token)
      user if user&.confirmation_sent_at&.after?(CONFIRMATION_TOKEN_EXPIRES_IN.ago)
    end
  end

  def confirmed?
    confirmed_at.present?
  end

  def confirm!
<% if reconfirmable? -%>
    @confirming = true
    self[self.class.authentication_email_column_name] = <%= unconfirmed_email_attribute %> if <%= unconfirmed_email_attribute %>.present?
    self.<%= unconfirmed_email_attribute %> = nil
    self.confirmed_at = Time.current
    self.confirmation_token = nil
    self.confirmation_sent_at = nil
    save!
  ensure
    @confirming = false
<% else -%>
    update!(confirmed_at: Time.current, confirmation_token: nil, confirmation_sent_at: nil)
<% end -%>
  end

  def send_confirmation_instructions
    generate_confirmation_token!
    ConfirmationsMailer.confirmation_instructions(self).deliver_later
  end

  def generate_confirmation_token!
    update!(confirmation_token: generate_confirmable_token, confirmation_sent_at: Time.current)
  end

  protected

  def generate_confirmable_token
    SecureRandom.urlsafe_base64(32)
  end
<% if reconfirmable? -%>

  private

  def postponing_email_change?
    !@confirming && attribute_changed?(self.class.authentication_email_column_name) && confirmed?
  end

  def postpone_email_change
    self.<%= unconfirmed_email_attribute %> = self[self.class.authentication_email_column_name]
    self[self.class.authentication_email_column_name] = attribute_in_database(self.class.authentication_email_column_name)
    self.confirmation_token = generate_confirmable_token
    self.confirmation_sent_at = Time.current
  end

  def deliver_reconfirmation_instructions
    ConfirmationsMailer.confirmation_instructions(self).deliver_later
  end
<% end -%>
end
