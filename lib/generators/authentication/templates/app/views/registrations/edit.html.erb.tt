<h1><%%= t('.heading') %></h1>

<%%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>
<%%= tag.div(flash[:notice], style: "color:green") if flash[:notice] %>

<%% if @user.errors.any? %>
  <ul style="color:red">
    <%% @user.errors.full_messages.each do |message| %>
      <li><%%= message %></li>
    <%% end %>
  </ul>
<%% end %>

<%%= form_with url: registration_path, method: :patch do |form| %>
  <%%= form.email_field authentication_email_column_name, required: true, autocomplete: "username", value: @user[authentication_email_column_name] %><br>
  <%%= form.password_field :password, autocomplete: "new-password", placeholder: t('.form.input.password.placeholder'), maxlength: <%= password_maxlength %> %><br>
  <%%= form.password_field :password_confirmation, autocomplete: "new-password", placeholder: t('.form.input.password_confirmation.placeholder'), maxlength: <%= password_maxlength %> %><br>
  <%%= form.submit t('.form.button.submit') %>
<%% end %>
<br>

<% if passkey? -%>
<%%= link_to t('.links.passkeys'), webauthn_credentials_path %>
<br><br>
<% end -%>
<%%= button_to t('.links.delete'), registration_path, method: :delete, data: { turbo_confirm: t('.confirmation.delete') } %>
