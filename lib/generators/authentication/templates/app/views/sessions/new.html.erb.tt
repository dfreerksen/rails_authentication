<%%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>
<%%= tag.div(flash[:notice], style: "color:green") if flash[:notice] %>

<% if ott? -%>
<%% if params[:with_password].blank? %>
<%%= form_with url: ott_path do |form| %>
  <%%= form.email_field authentication_email_column_name, required: true, autofocus: true, autocomplete: "username", placeholder: t('.ott.form.input.email.placeholder'), value: params[authentication_email_column_name] %><br>
  <%%= form.submit t('.ott.form.button.submit') %>
<%% end %>
<br>

<br><%%= link_to t('.links.session'), new_session_path(with_password: 1) %>
<%% else %>
<% end -%>
<%%= form_with url: session_path do |form| %>
  <%%= form.email_field authentication_email_column_name, required: true, autofocus: true, autocomplete: "username", placeholder: t('.session.form.input.email.placeholder'), value: params[authentication_email_column_name] %><br>
  <%%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: t('.session.form.input.password.placeholder'), maxlength: ActiveModel::SecurePassword::MAX_PASSWORD_LENGTH_ALLOWED %><br>
<% if rememberable? -%>
  <%%= form.check_box :remember_me %> <%%= form.label :remember_me, t('.session.form.input.remember.label') %><br>
<% end -%>
  <%%= form.submit t('.session.form.button.submit') %>
<%% end %>
<br>
<% if ott? -%>

<br><%%= link_to t('.links.ott'), new_session_path %>
<%% end %>
<% end -%>

<% if magic_link? -%>
<br><%%= link_to t('.links.magic_link'), new_magic_link_path %>
<% end -%>
<% if passkey? -%>
<br><%%= button_tag t('.links.passkey'), type: "button", id: "passkey-sign-in-button" %>
<%%= tag.span "", id: "passkey-sign-in-error", style: "color:red" %>

<%%= javascript_tag do %>
  (function () {
    function bufferEncode(value) {
      return btoa(String.fromCharCode.apply(null, new Uint8Array(value)))
        .replace(/\+/g, "-").replace(/\//g, "_").replace(/=/g, "");
    }

    function bufferDecode(value) {
      const padded = value.replace(/-/g, "+").replace(/_/g, "/");
      const raw = window.atob(padded);
      const buffer = new Uint8Array(raw.length);
      for (let i = 0; i < raw.length; i++) buffer[i] = raw.charCodeAt(i);
      return buffer.buffer;
    }

    document.getElementById("passkey-sign-in-button").addEventListener("click", async function () {
      const options = <%%= raw @webauthn_credential_options.to_json %>;
      options.challenge = bufferDecode(options.challenge);
      if (options.allowCredentials) {
        options.allowCredentials = options.allowCredentials.map(function (cred) {
          return Object.assign({}, cred, { id: bufferDecode(cred.id) });
        });
      }

      let credential;
      try {
        credential = await navigator.credentials.get({ publicKey: options });
      } catch (error) {
        // The browser's own message is technical, so show a translated one and log the original.
        console.error(error);
        document.getElementById("passkey-sign-in-error").textContent = error.name === "NotAllowedError"
          ? "<%%= j t('.error.cancelled') %>"
          : "<%%= j t('.error.passkey') %>";
        return;
      }

      const response = await fetch("<%%= passkey_session_path %>", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content
        },
        body: JSON.stringify({
          id: credential.id,
          rawId: bufferEncode(credential.rawId),
          type: credential.type,
          response: {
            clientDataJSON: bufferEncode(credential.response.clientDataJSON),
            authenticatorData: bufferEncode(credential.response.authenticatorData),
            signature: bufferEncode(credential.response.signature),
            userHandle: credential.response.userHandle ? bufferEncode(credential.response.userHandle) : null
          }
        })
      });

      const result = await response.json();
      if (response.ok) {
        window.location.href = result.redirect_to;
      } else {
        document.getElementById("passkey-sign-in-error").textContent = result.error || "<%%= j t('.error.passkey') %>";
      }
    });
  })();
<%% end %>
<% end -%>
<br><%%= link_to t('.links.forgot_password'), new_password_path %>
<% if registerable? -%>
<br><%%= link_to t('.links.sign_up'), new_registration_path %>
<% end -%>
<% if confirmable? -%>
<br><%%= link_to t('.links.resend_confirmation'), new_confirmation_path %>
<% end -%>
<% if lockable? -%>
<br><%%= link_to t('.links.resend_unlock'), new_unlock_path %>
<% end -%>
