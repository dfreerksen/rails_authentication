<h1><%%= t('.heading') %></h1>

<%%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>

<%%= form_with url: invitation_path(params[:token]), method: :patch do |form| %>
  <%%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", placeholder: t('.form.input.password.placeholder'), maxlength: <%= password_maxlength %> %><br>
  <%%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: t('.form.input.password_confirmation.placeholder'), maxlength: <%= password_maxlength %> %><br>
  <%%= form.submit t('.form.button.submit') %>
<%% end %>
