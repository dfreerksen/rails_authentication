<h1><%%= t('.heading') %></h1>

<%%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>
<%%= tag.div(flash[:notice], style: "color:green") if flash[:notice] %>

<%%= form_with url: invitations_path do |form| %>
  <%%= form.email_field :email_address, required: true, autofocus: true, placeholder: t('.form.input.email.placeholder') %><br>
  <%%= form.submit t('.form.button.submit') %>
<%% end %>
