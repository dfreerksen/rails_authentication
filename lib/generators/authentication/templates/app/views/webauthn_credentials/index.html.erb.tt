<h1><%%= t('.heading') %></h1>

<%%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>
<%%= tag.div(flash[:notice], style: "color:green") if flash[:notice] %>

<%% if @webauthn_credentials.empty? %>
  <p><%%= t('.none') %></p>
<%% else %>
  <ul>
    <%% @webauthn_credentials.each do |credential| %>
      <li>
        <%%= t('.account_added', nickname: credential.nickname, date_added: credential.created_at.to_date) %>
        <%%= button_to t('.buttons.remove'), webauthn_credential_path(credential), method: :delete, data: { turbo_confirm: t('.confirmations.remove') } %>
      </li>
    <%% end %>
  </ul>
<%% end %>

<br><%%= link_to t('.links.add'), new_webauthn_credential_path %>
