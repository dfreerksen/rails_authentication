# frozen_string_literal: true

class ConfirmationsMailer < ApplicationMailer
  def confirmation_instructions(user)
    @user = user
<% if reconfirmable? -%>
    mail subject: t('confirmations_mailer.confirmation_instructions.subject'), to: user.unconfirmed_email.presence || user.email_address
<% else -%>
    mail subject: t('confirmations_mailer.confirmation_instructions.subject'), to: user.email_address
<% end -%>
  end
end
