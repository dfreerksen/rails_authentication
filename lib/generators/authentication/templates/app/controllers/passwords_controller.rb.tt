# frozen_string_literal: true

class PasswordsController < ApplicationController
  allow_unauthenticated_access
  before_action :set_user_by_token, only: %i[ edit update ]
  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { redirect_to new_password_path, alert: t("flash.passwords.create.alert.rate_limited") }

  def new
  end

  def create
    if user = User.find_by(email_address: params[:email_address])
      user.send_reset_password_instructions
    end

    redirect_to new_session_path, notice: t("flash.passwords.create.notice")
  end

  def edit
  end

  def update
    if @user.update(params.permit(:password, :password_confirmation))
      @user.clear_reset_password_token!
<% if lockable? -%>
      @user.unlock!
<% end -%>
      terminate_all_sessions_for(@user)
      redirect_to new_session_path, notice: t("flash.passwords.update.notice")
    else
      redirect_to edit_password_path(params[:token]), alert: t("flash.passwords.update.alert.password_mismatch")
    end
  end

  private

  def set_user_by_token
    @user = User.find_by_valid_reset_password_token(params[:token])
    return if @user

    alert = if action_name == "edit"
      t("flash.passwords.edit.alert.invalid_token")
    else
      t("flash.passwords.update.alert.invalid_token")
    end
    redirect_to new_password_path, alert: alert
  end
end
