# frozen_string_literal: true

class InvitationsController < ApplicationController
  require_unauthenticated_access only: %i[ edit update ]
  before_action :set_user_by_token, only: %i[ edit update ]

  def new
  end

  def create
    user = User.invite!(invitation_params, invited_by: Current.user)

    if user.persisted?
      redirect_to new_invitation_path, notice: t("flash.invitations.create.notice", email: user[authentication_email_column_name])
    else
      redirect_to new_invitation_path, alert: user.errors.full_messages.to_sentence
    end
  end

  def edit
  end

  def update
    if @user.accept_invitation!(password: params[:password], password_confirmation: params[:password_confirmation])
      start_new_session_for @user
      redirect_to after_authentication_url, notice: t("flash.invitations.update.notice")
    else
      redirect_to edit_invitation_path(params[:token]), alert: @user.errors.full_messages.to_sentence
    end
  end

  private

  # Add any other attributes your User requires (e.g. :name) here and to the invitation form.
  def invitation_params
    params.permit(authentication_email_column_name)
  end

  def set_user_by_token
    @user = User.find_by_valid_invitation_token(params[:token])
    return if @user

    alert = if action_name == "edit"
      t("flash.invitations.edit.alert.invalid_token")
    else
      t("flash.invitations.update.alert.invalid_token")
    end
    redirect_to new_session_path, alert: alert
  end
end
