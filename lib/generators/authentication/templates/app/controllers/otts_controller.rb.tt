# frozen_string_literal: true

class OttsController < ApplicationController
  require_unauthenticated_access
  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { redirect_to new_session_path, alert: t("flash.otts.create.alert.rate_limited") }
  rate_limit to: 10, within: 3.minutes, only: :update, with: -> { redirect_to new_session_path, alert: t("flash.otts.update.alert.rate_limited") }

  def create
    email = params[authentication_email_column_name].presence || session[:ott_email]
    user = User.find_by(authentication_email_column_name => email)
    user&.send_ott
    session[:ott_email] = email

    redirect_to edit_ott_path, notice: t("flash.otts.create.notice")
  end

  def edit
    redirect_to new_session_path if session[:ott_email].blank?
  end

  def update
    user = User.find_by(authentication_email_column_name => session[:ott_email])

    case user && user.verify_ott(params[:code])
    when nil, :expired
      redirect_to new_session_path, alert: t("flash.otts.update.alert.invalid_code")
    when :exhausted
<% if trackable? -%>
      record_authentication_attempt(user, success: false, failure_reason: "ott_attempts_exhausted")
<% end -%>
      redirect_to new_session_path, alert: t("flash.otts.update.alert.too_many_attempts")
    when :invalid
<% if trackable? -%>
      record_authentication_attempt(user, success: false, failure_reason: "invalid_ott")
<% end -%>
      redirect_to edit_ott_path, alert: t("flash.otts.update.alert.incorrect_code")
    else
      complete_ott_sign_in(user)
    end
  end

  private

  def complete_ott_sign_in(user)
<% if lockable? -%>
    if user.locked?
<% if trackable? -%>
      record_authentication_attempt(user, success: false, failure_reason: "locked")
<% end -%>
      return redirect_to new_session_path, alert: t("flash.otts.update.alert.locked")
    end
<% end -%>
<% if confirmable? -%>
    unless user.confirmed?
<% if trackable? -%>
      record_authentication_attempt(user, success: false, failure_reason: "unconfirmed")
<% end -%>
      return redirect_to new_session_path, alert: t("flash.otts.update.alert.unconfirmed")
    end
<% end -%>
<% if invitable? -%>
    if user.invitation_pending?
<% if trackable? -%>
      record_authentication_attempt(user, success: false, failure_reason: "invitation_pending")
<% end -%>
      return redirect_to new_session_path, alert: t("flash.otts.update.alert.invitation_pending")
    end
<% end -%>
    # Add your own authentication restrictions specific to your application
    # if user.deleted_at.present?
<% if trackable? -%>
    #   record_authentication_attempt(user, success: false, failure_reason: "soft_deleted")
<% end -%>
    #   return redirect_to new_session_path, alert: "Your account is not available."
    # end

    user.consume_ott!
    session.delete(:ott_email)
<% if lockable? -%>
    user.reset_failed_attempts!
<% end -%>
<% if trackable? -%>
    record_authentication_attempt(user, success: true)
<% end -%>
<% if rememberable? -%>
    start_new_session_for user, remember: params[:remember_me] == "1"
<% else -%>
    start_new_session_for user
<% end -%>
    redirect_to after_authentication_url
  end
<% if trackable? -%>

  def record_authentication_attempt(user, success:, failure_reason: nil)
    UserAuth.record(user, request, success: success, failure_reason: failure_reason)
  end
<% end -%>
end
