# frozen_string_literal: true

class ConfirmationsController < ApplicationController
  # show stays open to everyone: with --reconfirmable, a signed-in user confirms an email change there.
  allow_unauthenticated_access only: :show
  require_unauthenticated_access except: :show
  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { redirect_to new_confirmation_path, alert: t("flash.confirmations.create.alert.rate_limited") }

  def new
  end

  def create
    user = User.find_by(email_address: params[:email_address])
<% if reconfirmable? -%>
    user.send_confirmation_instructions if user && (!user.confirmed? || user.unconfirmed_email.present?)
<% else -%>
    user.send_confirmation_instructions if user && !user.confirmed?
<% end -%>

    redirect_to new_session_path, notice: t("flash.confirmations.create.notice")
  end

  def show
    if user = User.find_by_valid_confirmation_token(params[:token])
      user.confirm!
      redirect_to new_session_path, notice: t("flash.confirmations.show.notice")
    else
      redirect_to new_confirmation_path, alert: t("flash.confirmations.show.alert.invalid_token")
    end
  end
end
