# frozen_string_literal: true

class UnlocksController < ApplicationController
  require_unauthenticated_access
  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { redirect_to new_unlock_path, alert: t("flash.unlocks.create.alert.rate_limited") }

  def new
  end

  def create
    user = User.find_by(authentication_email_column_name => params[authentication_email_column_name])
    user.send_unlock_instructions if user&.locked?

    redirect_to new_session_path, notice: t("flash.unlocks.create.notice")
  end

  def show
    if user = User.find_by_valid_unlock_token(params[:token])
      user.unlock!
      redirect_to new_session_path, notice: t("flash.unlocks.show.notice")
    else
      redirect_to new_unlock_path, alert: t("flash.unlocks.show.alert.invalid_token")
    end
  end
end
